package com.brokenfinger.vera.metadata.poc.calibration.inside

// detekt calibration fixture, one step inside a limit. Enabled only by scripts/detekt-calibrate.sh.

fun tenLines(input: Int): Int {
    var total = input
    total += 1
    total += 1
    total += 1
    total += 1
    total += 1
    total += 1
    return total
}
