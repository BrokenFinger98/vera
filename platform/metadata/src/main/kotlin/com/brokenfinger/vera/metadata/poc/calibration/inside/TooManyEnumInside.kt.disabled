    fun f04(x: Int): Int = x + 1
    fun f05(x: Int): Int = x + 2
    fun f06(x: Int): Int = x + 0
    fun f07(x: Int): Int = x + 1
    fun f08(x: Int): Int = x + 2
    fun f09(x: Int): Int = x + 0
    fun f10(x: Int): Int = x + 1
