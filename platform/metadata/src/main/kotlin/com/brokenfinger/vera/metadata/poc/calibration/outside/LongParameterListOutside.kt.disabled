package com.brokenfinger.vera.metadata.poc.calibration.outside

// detekt calibration fixture, one step outside a limit. Enabled only by scripts/detekt-calibrate.sh.

fun params5(a: Int, b: Int, c: Int, d: Int, e: Int): Int = a + b + c + d + e

class Ctor6(
    private val a: Int,
    private val b: Int,
    private val c: Int,
    private val d: Int,
    private val e: Int,
    private val f: Int,
) {
    fun sum(): Int = a + b + c + d + e + f
}
